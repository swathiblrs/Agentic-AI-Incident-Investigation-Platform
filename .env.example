APP_NAME="AI Security Alert Investigation Agent"
APP_ENV=local
RAG_TOP_K=5
RISK_THRESHOLD_HIGH=75
RISK_THRESHOLD_MEDIUM=45
DATABASE_URL=postgresql://incident:incident@localhost:5432/incident_response
USE_POSTGRES=false
POSTGRES_HOST=localhost
POSTGRES_DB=incident_response
POSTGRES_USER=incident
POSTGRES_PASSWORD=incident
REDIS_URL=redis://localhost:6379/0
AUTH_REQUIRED=true
JWT_SECRET_KEY=change-me-local-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
DEMO_USERNAME=analyst
DEMO_PASSWORD=analyst
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
