APP_NAME="Agentic AI Incident Investigation Platform"
APP_ENV=local
RAG_TOP_K=5
RISK_THRESHOLD_HIGH=75
RISK_THRESHOLD_MEDIUM=45
DATABASE_URL=postgresql://incident:incident@localhost:5432/incident_response
USE_POSTGRES=false
POSTGRES_HOST=localhost
POSTGRES_DB=incident_response
POSTGRES_USER=incident
POSTGRES_PASSWORD=incident
REDIS_URL=redis://localhost:6379/0
AUTH_REQUIRED=true
JWT_SECRET_KEY=change-me-local-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
DEMO_USERNAME=analyst
DEMO_PASSWORD=analyst
LLM_PROVIDER=openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIMENSIONS=384
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-haiku-latest
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=0.5
LLM_RETRY_MAX_SECONDS=4.0
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
EVALUATION_PROVIDER=auto
EVALUATION_MODEL=gpt-4o-mini
EVALUATION_MAX_RETRIES=2
A2A_PROVIDER=local
A2A_API_KEY=
A2A_AGENT_URLS={}
A2A_TIMEOUT_SECONDS=10
A2A_MAX_RETRIES=2
